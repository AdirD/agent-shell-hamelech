Requirement: the upload button should retry once on a network failure. No
dependency changes were requested.

Repository facts:
- The project uses npm. `package-lock.json` is tool-generated and CI runs
  `npm ci`, which installs exactly what the lockfile resolves.
- The agent ran `npm install` with a newer npm version during the session.

Treat this patch as the uncommitted working tree.

diff --git a/src/upload/button.ts b/src/upload/button.ts
index 2b3c4d5..6e7f8a9 100644
--- a/src/upload/button.ts
+++ b/src/upload/button.ts
@@ -4,3 +4,10 @@ import { NetworkError, sendFile } from './transport'
 export async function upload(file: File) {
-    return sendFile(file)
+    try {
+        return await sendFile(file)
+    } catch (error) {
+        if (error instanceof NetworkError) {
+            return sendFile(file)
+        }
+        throw error
+    }
 }
