{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edit-plan.schema.json",
  "title": "Portable podcast video edit plan",
  "description": "A strictly ordered, approved-script-backed plan for deterministic H.264/AAC podcast rendering.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "approval",
    "sources",
    "output",
    "canvas",
    "audio",
    "encoding",
    "speaker_crops",
    "sequence"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "script_path"],
      "properties": {
        "status": {
          "const": "approved"
        },
        "script_path": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "allOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "pattern": "\\.mp4$"
            }
          ]
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "background"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16384,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16384,
          "multipleOf": 2
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "background": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_rate", "channel_layout", "bitrate", "loudness"],
      "properties": {
        "sample_rate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "channel_layout": {
          "enum": ["mono", "stereo"]
        },
        "bitrate": {
          "type": "string",
          "pattern": "^[1-9][0-9]*k$"
        },
        "loudness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integrated_lufs", "true_peak_db", "range_lu"],
          "properties": {
            "integrated_lufs": {
              "type": "number",
              "minimum": -70,
              "maximum": -5
            },
            "true_peak_db": {
              "type": "number",
              "minimum": -9,
              "maximum": 0
            },
            "range_lu": {
              "type": "number",
              "minimum": 1,
              "maximum": 50
            }
          }
        }
      }
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_codec", "audio_codec", "pixel_format", "preset", "crf"],
      "properties": {
        "video_codec": {
          "const": "libx264"
        },
        "audio_codec": {
          "const": "aac"
        },
        "pixel_format": {
          "const": "yuv420p"
        },
        "preset": {
          "enum": [
            "ultrafast",
            "superfast",
            "veryfast",
            "faster",
            "fast",
            "medium",
            "slow",
            "slower",
            "veryslow"
          ]
        },
        "crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 51
        }
      }
    },
    "speaker_crops": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/speaker_crop"
      }
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {
          "type": {
            "const": "clip"
          }
        },
        "required": ["type"]
      },
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/clip"
          },
          {
            "$ref": "#/$defs/card"
          }
        ]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "video_stream", "audio_stream"],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "video_stream": {
          "type": "integer",
          "minimum": 0
        },
        "audio_stream": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "speaker_crop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "x",
        "y",
        "width",
        "height",
        "fit",
        "anchor_x",
        "anchor_y"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fit": {
          "enum": ["cover", "contain"]
        },
        "anchor_x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "anchor_y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "provenance",
        "source",
        "speaker_crop",
        "start",
        "end",
        "verbatim"
      ],
      "properties": {
        "type": {
          "const": "clip"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "provenance": {
          "const": "verbatim"
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "speaker_crop": {
          "$ref": "#/$defs/identifier"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "verbatim": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "provenance",
        "role",
        "duration",
        "title",
        "background",
        "text_color",
        "title_size",
        "subtitle_size"
      ],
      "properties": {
        "type": {
          "const": "card"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "provenance": {
          "const": "editorial"
        },
        "role": {
          "enum": ["title", "editorial_summary", "interstitial", "outro"]
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "subtitle": {
          "type": "string"
        },
        "background": {
          "$ref": "#/$defs/color"
        },
        "text_color": {
          "$ref": "#/$defs/color"
        },
        "title_size": {
          "type": "integer",
          "minimum": 8,
          "maximum": 512
        },
        "subtitle_size": {
          "type": "integer",
          "minimum": 8,
          "maximum": 512
        },
        "font_file": {
          "$ref": "#/$defs/path"
        }
      }
    }
  }
}
